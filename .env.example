# ==============================================================================
# ARKA Technovation Private Limited - Environment Variables
# ==============================================================================

# 1. Target Notification Email
# All website inquiries (contact, careers, news pitches, service audits) will be sent here.
# Currently set for testing to: gouravdon518@gmail.com
# To switch to production, change to: info@arkatechnovation.com
NOTIFICATION_EMAIL=gouravdon518@gmail.com

# 2. SMTP Delivery Configuration (For production or real Gmail sending)
# Option A: Standard SMTP (Gmail, Hostinger, Zoho, Brevo, AWS SES)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM="ARKA Technovation" <noreply@arkatechnovation.com>

# Option B: Gmail Shortcut
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Note: If no SMTP credentials are configured, the system automatically runs in
# test sandbox mode using Ethereal Email and outputs a live preview URL in the terminal!

